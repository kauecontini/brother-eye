{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brother Eye",
  "version": "0.0.0",
  "identifier": "com.brothereye.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brother Eye",
        "url": "index.html",
        "width": 520,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "tutor-hud",
        "title": "Brother Eye HUD",
        "url": "index.html?view=hud",
        "width": 360,
        "height": 96,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["main-capability", "hud-capability"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
