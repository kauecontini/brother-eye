{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brother-eye.local/rpc/desktop-rpc.schema.json",
  "title": "Brother Eye Desktop JSON-RPC 2.0",
  "description": "Contrato mínimo Desktop/Tauri Supervisor ↔ Core via JSON-RPC 2.0 sobre stdio. Não expõe shell, filesystem ou process arbitrário. Métodos futuros exigem nova versão.",
  "oneOf": [
    { "$ref": "#/$defs/HealthGetRequest" },
    { "$ref": "#/$defs/HealthGetSuccess" },
    { "$ref": "#/$defs/CoreShutdownRequest" },
    { "$ref": "#/$defs/CoreShutdownSuccess" },
    { "$ref": "#/$defs/CoreHealthChangedNotification" },
    { "$ref": "#/$defs/CoreEventNotification" },
    { "$ref": "#/$defs/JsonRpcErrorResponse" }
  ],
  "$defs": {
    "JsonRpcVersion": {
      "const": "2.0"
    },
    "RequestId": {
      "type": ["string", "integer"]
    },
    "HealthStatus": {
      "$ref": "https://schemas.brother-eye.local/common/domain-enums.schema.json#/$defs/HealthStatus"
    },
    "ComponentHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "components"],
      "properties": {
        "status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ComponentHealth"
          },
          "description": "Mapa extensível de componentes conhecidos (core, storage, observation, hermes, etc.)."
        }
      }
    },
    "HealthGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "health.get"
        },
        "params": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "HealthGetSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "result": {
          "$ref": "#/$defs/HealthReport"
        }
      }
    },
    "CoreShutdownRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "core.shutdown"
        },
        "params": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "CoreShutdownSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted"],
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "CoreHealthChangedNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "core.health_changed"
        },
        "params": {
          "$ref": "#/$defs/HealthReport"
        }
      }
    },
    "CoreEventNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "core.event"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": {
              "$ref": "https://schemas.brother-eye.local/events/event-envelope.schema.json"
            }
          }
        }
      }
    },
    "JsonRpcErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "type": ["string", "integer", "null"]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "data": true
          }
        }
      }
    }
  }
}
